# ConstructIQ Environment Configuration Template

# NVIDIA_API_KEY: Required for NVIDIA NIM AI API calls.
# Powers the ConstructIQ Copilot with Meta Llama 3.2 on NVIDIA accelerated infrastructure.
# Obtain your key at: https://build.nvidia.com/
NVIDIA_API_KEY="nvapi-your-nvidia-api-key-here"

# VITE_NVIDIA_API_KEY: (Client-side) For direct NVIDIA NIM API calls from the browser.
# Enables real-time AI in the AICopilotDrawer without requiring the backend proxy.
VITE_NVIDIA_API_KEY="nvapi-your-nvidia-api-key-here"

# NVIDIA_MODEL: The default model hosted on NVIDIA NIM
# Options: meta/llama-3.2-11b-vision-instruct, meta/llama-3.2-90b-vision-instruct
NVIDIA_MODEL="meta/llama-3.2-11b-vision-instruct"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Port Configuration
PORT=3001
VITE_PORT=3000
